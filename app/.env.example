VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public VAPID key for Web Push subscriptions (safe to expose client-side).
# Generate a pair with `npx web-push generate-vapid-keys` and set the private
# half + VAPID_SUBJECT as Supabase Edge Function secrets (never here) —
# `supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:you@example.com`
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
